# Mal for release-signering.
# Kopier til android/keystore.properties og fyll inn verdiene:
#   cp android/keystore.properties.example android/keystore.properties
#
# Den ekte filen er ignorert av git. Denne malen skal være med i git.
#
# storeFile: absolutt sti til upload-keystoren, f.eks.
#   storeFile=/home/bruker/upload-keystore.jks
#
# CI kan i stedet bruke miljøvariablene ANDROID_KEYSTORE_PATH,
# ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS og ANDROID_KEY_PASSWORD.
#
# La verdiene stå tomme til du fyller dem ut, slik at et release-bygg
# fortsatt stopper med den tydelige «release signing is not configured»-feilen.

storeFile=
storePassword=
keyAlias=upload
keyPassword=
