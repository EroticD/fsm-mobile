{
  "name": "fsm-mobile",
  "version": "0.8.11",
  "private": true,
  "type": "module",
  "description": "Native Android- og iOS-skallet for FSM-plattformen",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "assets": "node scripts/generate-mobile-assets.mjs",
    "check:push": "node scripts/check-push-config.mjs",
    "check:push:release": "node scripts/check-push-config.mjs --mode release",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "sharp": "^0.35.5"
  }
}
